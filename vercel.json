{
  "framework": null,
  "installCommand": "./vercel-install.sh",
  "buildCommand": "export PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" && ./build.sh",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.hamdimechelloukh.com" }],
      "status": 308,
      "headers": { "Location": "https://hamdimechelloukh.com/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/en(/.*)?", "status": 404, "dest": "/en/404.html" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}

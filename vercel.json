{
  "framework": null,
  "installCommand": "./vercel-install.sh",
  "buildCommand": "export PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" && ./build.sh",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hamdimechelloukh.com" }],
      "destination": "https://hamdimechelloukh.com/:path*",
      "permanent": true
    }
  ]
}
